---
import { Picture } from 'astro:assets';
import ServicePage from '../../components/ServicePage.astro';
import photoBoyana from '../../assets/img/photo-scaffrent-boyana.jpg';
---

<ServicePage
  title="Реклами в Google | Riddle Marketing"
  description="Показваме ви на хората, които пишат вашата услуга в Google, във вашия район. Броим обажданията и поръчките от рекламата. За местни бизнеси в България."
  headline="Клиенти, които ви търсят точно сега."
  opening="Показваме ви на хората, които пишат вашата услуга в Google, във вашия район."
  exampleClient="Scaff-Rent, скеле под наем"
  whatYouGet={[
    'Реклами към хора, които търсят вашата услуга точно сега.',
    'Показване във вашия район.',
    'Броим обажданията и поръчките от рекламата.',
    'Местим парите към това, което носи клиенти.',
  ]}
  steps={[
    'Разговор: каква услуга, кой район.',
    'Пускаме рекламите и свързваме измерването.',
    'Гледаме числата и местим бюджета към това, което работи.',
  ]}
  whenNot={{
    situation: 'Едва смогвате с клиентите, които вече имате.',
    verdict: 'Реклама не ви трябва.',
  }}
  measureLine="Всяка реклама се измерва. Сайтът също."
  faq={[
    {
      q: 'Ще разбера ли какво носи рекламата?',
      a: 'Да. Броим обажданията, записаните часове и поръчките и ви показваме откъде идват.',
    },
    {
      q: 'Колко да отделя за реклама?',
      a: 'Строго индивидуално е. Зависи какво искаме да постигнем и най-вече къде.',
    },
    {
      q: 'Бюджетът при вас ли отива?',
      a: 'Не. Бюджета за реклама плащате директно на Google. Нашата работа е отделно.',
    },
    {
      q: 'Кога ще видя резултат?',
      a: 'Първите числа виждате още на следващия ден. След първия месец правим анализ заедно, онлайн или на живо, както ви е удобно.',
    },
  ]}
>
  <Picture
    src={photoBoyana}
    alt="Scaff-Rent, обект в Бояна"
    formats={['avif', 'webp']}
    widths={[560, 900, 1360]}
    sizes="(max-width: 760px) 100vw, 47vw"
    loading="eager"
    class="ads-img"
  />
</ServicePage>

<style>
  :global(.ads-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
