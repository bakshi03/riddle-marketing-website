---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import viberLogo from '../assets/img/logo-viber.png';
import { PHONE_DISPLAY, PHONE_HREF, VIBER_URL, BOOKING_URL, EMAIL, FORM_ENDPOINT } from '../lib/site';
import { faq } from '../data/faq';
---

<Base
  title="Контакт: 0897 853 219 | Riddle Marketing"
  description="Обадете се на 0897 853 219 или запазете безплатен 30-минутен разговор. Говорите директно с хората, които ще работят по вашия бизнес."
>
  <Header current="contact" />

  <section class="hero">
    <h1>Обадете се или запазете час за разговор.</h1>
    <div class="columns">
      <div class="contact-col">
        <a href={PHONE_HREF} class="big-phone">{PHONE_DISPLAY}</a>
        <div class="cta-row">
          <a href={BOOKING_URL} class="cta">Запазете 30-минутен разговор</a>
          <a href={VIBER_URL} class="viber">
            <Image src={viberLogo} alt="" width={52} height={52} class="viber-icon" />
            <span>Пишете във Viber</span>
          </a>
        </div>
        {EMAIL && <a href={`mailto:${EMAIL}`} class="email">{EMAIL}</a>}
      </div>
      <div class="card">
        <h2>Какво става в тези 30 минути</h2>
        <p>Разказвате ни за бизнеса и откъде идват клиентите ви сега.</p>
        <p>Отваряме заедно сайта и профила ви в Google.</p>
        <p>Казваме ви какво бихме направили първо и какво не ви трябва.</p>
        <p>Разговорът е безплатен. Ако не можем да помогнем, ще ви го кажем.</p>
      </div>
    </div>
  </section>

  {
    FORM_ENDPOINT && (
      <section class="lead">
        <div class="lead-inner">
          <div class="lead-head">
            <h2>Безплатен преглед на профила и сайта ви.</h2>
            <p>Изпратете ни линк. Ще ви кажем какво бихме подобрили първо.</p>
          </div>
          <form class="lead-form" id="lead-form" data-endpoint={FORM_ENDPOINT}>
            <label>
              <span>Име</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              <span>Телефон</span>
              <input type="tel" name="phone" required autocomplete="tel" />
            </label>
            <label>
              <span>Линк към сайта или профила ви</span>
              <input type="url" name="link" required placeholder="https://" />
            </label>
            <label class="lead-consent">
              <input type="checkbox" name="consent" required />
              <span>
                Съгласявам се данните от формата да се използват за връзка с мен, според{' '}
                <a href="/poveritelnost/">политиката за поверителност</a>.
              </span>
            </label>
            <button type="submit" class="lead-btn">Изпратете</button>
            <p class="lead-status" id="lead-status" role="status" hidden />
          </form>
        </div>
      </section>
    )
  }

  <Faq items={faq} />

  <Footer />

  <script>
    // Lead form: POST to the endpoint from data-endpoint, then confirm and
    // fire generate_lead. The whole block is absent while FORM_ENDPOINT is
    // empty, so this script just finds nothing and exits.
    const form = document.getElementById('lead-form') as HTMLFormElement | null;
    const status = document.getElementById('lead-status');
    if (form && status) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        status.hidden = true;
        fetch(form.dataset.endpoint!, { method: 'POST', mode: 'no-cors', body: new FormData(form) })
          .then(() => {
            form.reset();
            status.textContent = 'Получихме данните. Ще се свържем с вас до един работен ден.';
            status.hidden = false;
            const g = (window as any).gtag;
            if (typeof g === 'function') g('event', 'generate_lead', { page_path: location.pathname });
          })
          .catch(() => {
            status.textContent = 'Нещо се обърка. Обадете се или ни пишете във Viber.';
            status.hidden = false;
          })
          .finally(() => {
            btn.disabled = false;
          });
      });
    }
  </script>
</Base>

<style>
  .hero {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 128px) clamp(20px, 5vw, 72px) clamp(64px, 8vw, 120px);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(60px, 9vw, 148px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 12ch;
  }
  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: 56px clamp(40px, 6vw, 104px);
    margin-top: clamp(56px, 7vw, 112px);
    align-items: flex-start;
  }
  .contact-col {
    flex: 1 1 480px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .big-phone {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(64px, 8.5vw, 136px);
    line-height: 0.9;
    text-decoration: none;
    letter-spacing: -0.01em;
    /* The number must never break onto two lines. */
    white-space: nowrap;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
  }
  .cta {
    background: var(--accent);
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
    padding: 20px 28px;
    border-radius: 4px;
    text-decoration: none;
  }
  .cta:hover {
    color: var(--text);
  }
  .viber {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 600;
  }
  .viber :global(.viber-icon) {
    width: 26px;
    height: 26px;
  }
  .email {
    font-size: 19px;
    font-weight: 600;
  }
  dl {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 32px;
    font-size: 18px;
    line-height: 1.4;
    max-width: 520px;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  .card {
    flex: 0 1 460px;
    flex-grow: 1;
    max-width: 560px;
    background: var(--bg-alt);
    padding: clamp(28px, 3vw, 44px);
    border-radius: 4px;
  }
  .card h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 3.6vw, 52px);
    line-height: 0.95;
    margin: 0 0 24px;
  }
  .card p {
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.18);
    font-size: 18px;
    line-height: 1.45;
  }
  .card p:last-child {
    padding-bottom: 0;
  }
  .lead {
    background: var(--bg-alt);
  }
  .lead-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 112px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px clamp(40px, 6vw, 104px);
    align-items: flex-start;
  }
  .lead-head {
    flex: 1 1 420px;
  }
  .lead-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 0.95;
    margin: 0;
    max-width: 14ch;
  }
  .lead-head p {
    margin: 20px 0 0;
    font-size: 20px;
    line-height: 1.45;
    max-width: 36ch;
  }
  .lead-form {
    flex: 1 1 420px;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .lead-form label:not(.lead-consent) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
  }
  .lead-form input:not([type='checkbox']) {
    font: 400 18px var(--font-body);
    padding: 14px 16px;
    border: 1px solid rgba(26, 26, 23, 0.35);
    border-radius: 4px;
    background: #ffffff;
    color: var(--text);
  }
  .lead-consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.45;
  }
  .lead-consent input {
    margin-top: 3px;
  }
  .lead-btn {
    align-self: flex-start;
    background: var(--accent);
    color: var(--text);
    font: 700 18px var(--font-body);
    padding: 18px 28px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .lead-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .lead-status {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }
</style>
