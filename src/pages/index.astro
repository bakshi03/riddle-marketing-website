---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReportingBlock from '../components/ReportingBlock.astro';
import PromiseBlock from '../components/PromiseBlock.astro';
import { projects } from '../data/projects';
import { results21cutz } from '../data/results';
import { getPublishedCases, withCaseLink } from '../lib/cases';
import { PHONE_DISPLAY, PHONE_HREF, VIBER_URL, BOOKING_URL } from '../lib/site';
import logo21cutz from '../assets/img/logo-21cutz.png';
import logoScaffrent from '../assets/img/logo-scaffrent.png';
import logoHairsupply from '../assets/img/logo-hairsupply28.jpg';
import photoSalon from '../assets/img/photo-21cutz-interior.jpg';
import logoGoogleBusiness from '../assets/img/logo-google-business.png';
import logoGoogleMaps from '../assets/img/logo-google-maps.png';
import logoGoogleAds from '../assets/img/logo-google-ads.png';
import logoWordpress from '../assets/img/logo-wordpress.png';
import logoShopify from '../assets/img/logo-shopify.svg';
import logoViber from '../assets/img/logo-viber.png';
import logoGa4 from '../assets/img/logo-ga4.svg';
import logoGtm from '../assets/img/logo-gtm.svg';
import logoMeta from '../assets/img/logo-meta.svg';
import logoInstagram from '../assets/img/logo-instagram.svg';
import mapsShot from '../assets/img/maps-21cutz.png';
import reviewsShot from '../assets/img/reviews-21cutz.png';
import bookingShot from '../assets/img/booking-21cutz.png';

const tools = [
  { icon: logoGoogleAds, label: 'Google Ads', cap: 'реклами при търсене в Google' },
  { icon: logoGoogleMaps, label: 'Google Maps', cap: 'как ви намират наблизо' },
  { icon: logoGa4, label: 'Google Analytics', cap: 'броим кой идва на сайта' },
  { icon: logoGtm, label: 'Google Tag Manager', cap: 'свързва сайта с измерването' },
  { icon: logoWordpress, label: 'WordPress', cap: 'с него правим сайтове' },
  { icon: logoViber, label: 'Viber', cap: 'за директна връзка с нас' },
  { icon: logoGoogleBusiness, label: 'Google Business Profile', cap: 'профилът ви в Google и Maps' },
];

const circleCards = [
  { title: 'Намират ви', line: 'В Google, в Maps и в рекламите.' },
  { title: 'Доверяват ви се', line: 'Истински снимки, отзиви и бърз сайт.' },
  { title: 'Свързват се', line: 'Обаждане, Viber, записан час или поръчка.' },
  { title: 'Измерваме', line: 'Виждате откъде идва всеки клиент, в табло на живо.' },
  { title: 'Подобряваме', line: 'Местим бюджета към това, което носи клиенти.' },
];

const published = new Map((await getPublishedCases()).map((e) => [e.id, e]));
const hasPublishedCases = published.size > 0;
const cards = [projects.cutz, projects.scaffrent, projects.hairsupply].map((p) =>
  withCaseLink(p, published)
);
---

<Base
  title="Riddle Marketing: сайтове, Google и реклами за местни бизнеси"
  description="Свързваме сайта с Google, рекламите и измерването, за да ви намират повече хора и да виждате кое носи клиенти. Сайтове, Google бизнес профили, реклами и проследяване за местни бизнеси в България."
>
  <Header current="home" />

  <section class="hero">
    <div class="hero-left">
      <h1>Сайтът е само началото.</h1>
      <div class="hero-sub">
        <p>Свързваме сайта с Google, рекламите и измерването, за да ви намират повече хора и да виждате кое носи клиенти.</p>
        <div class="hero-cta">
          <a href={BOOKING_URL} class="cta">Запазете 30-минутен разговор</a>
          {hasPublishedCases && <a href="/proekti/" class="cta-ghost">Вижте проектите</a>}
          <a href={PHONE_HREF} class="hero-phone">или се обадете: {PHONE_DISPLAY}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="clients-strip">
    <p>Някои от бизнесите, с които работим.</p>
    <div class="client-logos">
      <div class="client-tile dark-tile">
        <Image src={logo21cutz} alt="21cutz" width={352} height={152} loading="eager" class="client-img cutz" />
      </div>
      <div class="client-tile">
        <Image src={logoScaffrent} alt="Scaff-Rent" width={352} height={168} loading="eager" class="client-img scaffrent" />
      </div>
      <div class="client-tile">
        <Image src={logoHairsupply} alt="HairSupply28" width={352} height={140} loading="eager" class="client-img hairsupply" />
      </div>
    </div>
  </section>

  <section class="circle">
    <div class="circle-inner">
      <div class="circle-head">
        <h2>Затваряме целия кръг.</h2>
        <p>Всичко работи заедно, за да идват клиенти и поръчки.</p>
      </div>

      <div class="circle-cards">
        {
          circleCards.map((c) => (
            <div class="circle-card">
              <h3>{c.title}</h3>
              <p>{c.line}</p>
            </div>
          ))
        }
      </div>

      <div class="circle-flow">
        <figure class="flow-step">
          <div class="phone-frame">
            <Picture src={mapsShot} alt="21cutz в Google Maps" formats={['avif', 'webp']} widths={[180, 360]} sizes="180px" loading="lazy" class="phone-img" />
          </div>
          <figcaption>Намират 21cutz в Maps</figcaption>
        </figure>
        <figure class="flow-step">
          <div class="phone-frame">
            <Picture src={reviewsShot} alt="Отзиви на 21cutz.com" formats={['avif', 'webp']} widths={[180, 360]} sizes="180px" loading="lazy" class="phone-img" />
          </div>
          <figcaption>Разглеждат сайта и отзивите</figcaption>
        </figure>
        <figure class="flow-step">
          <div class="phone-frame">
            <Picture src={bookingShot} alt="Записване на час в book.21cutz.com" formats={['avif', 'webp']} widths={[180, 360]} sizes="180px" loading="lazy" class="phone-img" />
          </div>
          <figcaption>Записват си час</figcaption>
        </figure>
      </div>

      <p class="circle-restart">После кръгът започва отначало.</p>
    </div>
  </section>

  <section class="result-block">
    <div class="result-inner">
      <p class="result-label">{results21cutz.label}</p>
      <div class="result-numbers">
        {
          results21cutz.numbers.map((n) => (
            <p class="num">
              <span class="num-value">{n.value}</span>
              <span class="num-label">{n.label}</span>
            </p>
          ))
        }
        <p class="num budget">
          <span class="num-value">{results21cutz.budget.value}</span>
          <span class="num-label">{results21cutz.budget.label}</span>
        </p>
      </div>
      <div class="result-foot">
        <p class="result-source">{results21cutz.source}</p>
        <a href={results21cutz.link.href} class="result-link">{results21cutz.link.label}</a>
      </div>
    </div>
  </section>

  <ReportingBlock />

  <section class="selected">
    <div class="selected-head">
      <h2>Избрани проекти.</h2>
      <div class="selected-sub">
        <p>Няколко случая, които показват как работим.</p>
        <a href="/proekti/">Вижте всички</a>
      </div>
    </div>
    <div class="selected-grid">
      {cards.map((c) => <ProjectCard {...c} aspect="4 / 3" />)}
    </div>
  </section>

  <section class="not-needed">
    <div class="not-needed-inner">
      <h2>Казваме ви и какво не ви трябва.</h2>
      <div class="not-needed-text">
        <p>Ако ви стига подреден профил в Google, няма да ви продаваме сайт и реклами.</p>
        <a href="/uslugi/#ne">Кога ще ви кажем да не харчите</a>
      </div>
    </div>
  </section>

  <PromiseBlock />

  <section class="tools">
    <h2>С тези инструменти работим всеки ден.</h2>
    <div class="tools-grid">
      {
        tools.map((t) => (
          <div class="tool">
            <Image src={t.icon} alt="" width={72} height={72} loading="lazy" class="tool-icon" />
            <span class="tool-text">
              <span>{t.label}</span>
              <span class="tool-cap">{t.cap}</span>
            </span>
          </div>
        ))
      }
      <div class="tool">
        <span class="tool-text">
          <Image src={logoMeta} alt="Meta" width={280} height={56} loading="lazy" class="tool-meta" />
          <span class="tool-cap">реклами във Facebook</span>
        </span>
      </div>
      <div class="tool">
        <Image src={logoInstagram} alt="" width={72} height={72} loading="lazy" class="tool-icon" />
        <span class="tool-text">
          <span>Instagram</span>
          <span class="tool-cap">реклами със снимки и видео</span>
        </span>
      </div>
      <div class="tool">
        <Image src={logoShopify} alt="" width={72} height={72} loading="lazy" class="tool-icon" />
        <span class="tool-text">
          <span>Shopify</span>
          <span class="tool-cap">за онлайн магазини</span>
        </span>
      </div>
    </div>
  </section>

  <section class="person">
    <div class="person-inner">
      <h2>Говорите с хората, които вършат работата.</h2>
      <p>Малък екип от София. Без посредници между вас и тези, които правят сайта и рекламите.</p>
      <div class="person-links">
        <a href={PHONE_HREF} class="person-phone">{PHONE_DISPLAY}</a>
        <a href={VIBER_URL}>Viber</a>
        <a href="/za-nas/">Повече за нас</a>
      </div>
    </div>
    <div class="person-photo">
      <Picture
        src={photoSalon}
        alt="Салонът на 21cutz, наш клиент"
        formats={['avif', 'webp']}
        widths={[400, 800]}
        sizes="(max-width: 759px) 100vw, 400px"
        loading="lazy"
        class="person-img"
      />
    </div>
  </section>

  <Footer />
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }
  .hero-left {
    flex: 1 1 560px;
    padding: clamp(48px, 7vw, 120px) clamp(20px, 5vw, 72px) clamp(40px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(68px, 10.5vw, 176px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 7.5ch;
  }
  .hero-sub {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 520px;
  }
  .hero-sub > p {
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.45;
    margin: 0;
    text-wrap: pretty;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .cta {
    background: var(--accent);
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
    padding: 20px 28px;
    border-radius: 4px;
    text-decoration: none;
  }
  .cta:hover {
    color: var(--text);
  }
  .hero-phone {
    font-size: 18px;
    font-weight: 500;
  }
  .cta-ghost {
    font-weight: 700;
    font-size: 18px;
    padding: 19px 28px;
    border: 1px solid var(--text);
    border-radius: 4px;
    text-decoration: none;
  }
  .clients-strip {
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
  }
  .clients-strip > p {
    flex: 0 1 220px;
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
  }
  .client-logos {
    flex: 1 1 560px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .client-tile {
    background: #ffffff;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
  }
  .client-tile.dark-tile {
    background: #0a0a0a;
  }
  .client-tile :global(.client-img) {
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .client-tile :global(.client-img.cutz) {
    max-height: 76px;
  }
  .client-tile :global(.client-img.scaffrent) {
    max-height: 84px;
  }
  .client-tile :global(.client-img.hairsupply) {
    max-height: 70px;
  }
  .circle {
    background: var(--dark);
    color: var(--bg);
  }
  .circle-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 160px) clamp(20px, 5vw, 72px);
  }
  .circle-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  .circle-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(60px, 9vw, 150px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 8ch;
  }
  .circle-head p {
    margin: 0;
    max-width: 30ch;
    font-size: 20px;
    line-height: 1.45;
    color: var(--muted-on-dark);
  }
  .circle-cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0 clamp(20px, 2.5vw, 40px);
  }
  @media (max-width: 999.98px) {
    .circle-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .circle-card {
    padding: 24px 0 28px;
    border-top: 1px solid rgba(243, 240, 233, 0.22);
  }
  .circle-card h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 0.95;
    margin: 0;
  }
  .circle-card p {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.45;
    color: var(--muted-on-dark);
  }
  .circle-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 24px clamp(24px, 3vw, 48px);
    margin-top: clamp(40px, 5vw, 64px);
  }
  .flow-step {
    margin: 0;
    flex: 0 1 180px;
  }
  .phone-frame {
    aspect-ratio: 9 / 19;
    border: 1px solid rgba(243, 240, 233, 0.35);
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .phone-frame :global(.phone-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .flow-step figcaption {
    margin-top: 10px;
    font-size: 15px;
    color: var(--muted-on-dark);
  }
  .circle-restart {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 3.4vw, 52px);
    line-height: 1;
    margin: clamp(40px, 5vw, 64px) 0 0;
  }
  .result-block {
    background: var(--bg-alt);
  }
  .result-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) clamp(20px, 5vw, 72px);
  }
  .result-label {
    margin: 0 0 clamp(28px, 3vw, 40px);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 0.95;
  }
  .result-numbers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 24px clamp(24px, 3vw, 48px);
  }
  .num {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 16px;
    border-top: 1px solid rgba(26, 26, 23, 0.25);
  }
  .num-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 5.5vw, 88px);
    line-height: 0.9;
  }
  .num-label {
    font-size: 17px;
    line-height: 1.35;
  }
  .result-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 32px;
    margin-top: clamp(28px, 3vw, 40px);
  }
  .result-source {
    margin: 0;
    font-size: 15px;
    color: rgba(26, 26, 23, 0.7);
  }
  .result-link {
    font-size: 18px;
    font-weight: 600;
  }
  .not-needed {
    background: var(--bg-alt);
  }
  .not-needed-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 160px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
    align-items: flex-end;
  }
  .not-needed h2 {
    flex: 1 1 620px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .not-needed-text {
    flex: 0 1 380px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .not-needed-text p {
    margin: 0;
    font-size: 22px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .not-needed-text a {
    font-size: 18px;
    font-weight: 600;
  }
  .tools {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(72px, 8vw, 128px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
  }
  .tools h2 {
    flex: 0 1 380px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 0.95;
    margin: 0;
  }
  .tools-grid {
    flex: 1 1 620px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    column-gap: 32px;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.16);
  }
  .tool span {
    font-size: 19px;
    font-weight: 600;
  }
  .tool-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tool .tool-cap {
    font-size: 15px;
    font-weight: 400;
    color: rgba(26, 26, 23, 0.65);
  }
  .tool :global(.tool-icon) {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  .tool :global(.tool-meta) {
    height: 28px;
    width: auto;
  }
  .selected {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(72px, 8vw, 128px) clamp(20px, 5vw, 72px) clamp(96px, 10vw, 160px);
  }
  .selected-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    align-items: flex-end;
    justify-content: space-between;
    margin: 0 0 clamp(40px, 5vw, 64px);
  }
  .selected-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 7vw, 112px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .selected-sub {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 34ch;
  }
  .selected-sub p {
    margin: 0;
    font-size: 19px;
    line-height: 1.45;
  }
  .selected-sub a {
    font-size: 18px;
    font-weight: 600;
  }
  .selected-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 56px clamp(20px, 3vw, 40px);
  }
  .person {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-top: 1px solid rgba(26, 26, 23, 0.14);
  }
  .person-inner {
    flex: 1 1 440px;
    padding: clamp(48px, 7vw, 112px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }
  .person h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 7.5vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 8ch;
  }
  .person-inner > p {
    margin: 0;
    font-size: 22px;
    line-height: 1.45;
    max-width: 30ch;
  }
  .person-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
  }
  .person-phone {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4vw, 56px);
    line-height: 1;
    text-decoration: none;
  }
  .person-links a:not(.person-phone) {
    font-size: 18px;
  }
  .person-photo {
    flex: 1 1 360px;
    min-height: 320px;
    background: var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .person-photo :global(.person-img) {
    width: min(100%, 400px);
    height: auto;
    display: block;
  }
</style>
