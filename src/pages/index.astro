---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chip from '../components/Chip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import logo21cutz from '../assets/img/logo-21cutz.png';
import logoScaffrent from '../assets/img/logo-scaffrent.png';
import logoHairsupply from '../assets/img/logo-hairsupply28.jpg';
import ladybird from '../assets/img/ladybird.svg';
import logoGoogleBusiness from '../assets/img/logo-google-business.png';
import logoGoogleMaps from '../assets/img/logo-google-maps.png';
import logoGoogleAds from '../assets/img/logo-google-ads.png';
import logoWordpress from '../assets/img/logo-wordpress.png';
import logoShopify from '../assets/img/logo-shopify.svg';
import logoViber from '../assets/img/logo-viber.png';
import logoGa4 from '../assets/img/logo-ga4.svg';
import logoGtm from '../assets/img/logo-gtm.svg';
import logoMeta from '../assets/img/logo-meta.svg';
import logoInstagram from '../assets/img/logo-instagram.svg';
import mapsShot from '../assets/img/maps-21cutz.png';
import reviewsShot from '../assets/img/reviews-21cutz.png';
import bookingShot from '../assets/img/booking-21cutz.png';
import chart from '../assets/img/chart.png';

const tools = [
  { icon: logoGoogleAds, label: 'Google Ads' },
  { icon: logoGoogleMaps, label: 'Google Maps' },
  { icon: logoGa4, label: 'Google Analytics' },
  { icon: logoGtm, label: 'Google Tag Manager' },
  { icon: logoWordpress, label: 'WordPress' },
  { icon: logoViber, label: 'Viber' },
  { icon: logoGoogleBusiness, label: 'Google Business Profile' },
];

const cards = [projects.cutz, projects.scaffrent, projects.hairsupply];
---

<Base
  title="Riddle Marketing — сайтове, Google и реклами за местни бизнеси"
  description="Свързваме сайта с Google, рекламите и измерването, за да ви търсят повече хора. Сайтове, Google бизнес профили, реклами и проследяване за местни бизнеси в България."
>
  <Header current="home" />

  <section class="hero">
    <div class="hero-left">
      <h1>Сайтът е само началото.</h1>
      <div class="hero-sub">
        <p>Свързваме сайта с Google, рекламите и измерването, за да ви търсят повече хора.</p>
        <div class="hero-cta">
          <a href="https://cal.com/tihomir-paunov-9sigpg/безплатен-30-минутен-разговор" class="cta">Запазете 30-минутен разговор</a>
          <a href="tel:+359897853219" class="hero-phone">или се обадете: 0897 853 219</a>
        </div>
      </div>
    </div>
    <div class="hero-right">
      <p class="steps-label">Какво правим, по ред:</p>
      <p class="step">Намират ви</p>
      <p class="step indent-1">Доверяват ви се</p>
      <p class="step indent-2 accent">Свързват се</p>
      <p class="step indent-1">Измерваме</p>
      <p class="step">Подобряваме</p>
    </div>
  </section>

  <section class="clients-strip">
    <p>Някои от бизнесите, с които работим.</p>
    <div class="client-logos">
      <div class="client-tile dark-tile">
        <Image src={logo21cutz} alt="21cutz" width={352} height={152} loading="eager" class="client-img cutz" />
      </div>
      <div class="client-tile">
        <Image src={logoScaffrent} alt="Scaff-Rent" width={352} height={168} loading="eager" class="client-img scaffrent" />
      </div>
      <div class="client-tile">
        <Image src={logoHairsupply} alt="HairSupply28" width={352} height={140} loading="eager" class="client-img hairsupply" />
      </div>
      <div class="client-tile ladybird-tile">
        <Image src={ladybird} alt="Djidji Stil" width={176} height={176} loading="eager" class="client-img ladybird" />
      </div>
    </div>
  </section>

  <section class="circle">
    <div class="circle-inner">
      <div class="circle-head">
        <h2>Затваряме целия кръг.</h2>
        <p>Всичко трябва да работи заедно, за да идват клиенти и поръчки.</p>
      </div>

      <div class="row">
        <div class="row-text">
          <h3>Намират ви</h3>
          <p>В търсенето на Google, в Maps и в рекламите.</p>
          <div class="chips">
            <Chip icon={logoGoogleBusiness} label="Google Business Profile" bg="#FFFFFF" />
            <Chip icon={logoGoogleMaps} label="Google Maps" />
            <Chip icon={logoGoogleAds} label="Google Ads" />
          </div>
        </div>
        <div class="phone-frame">
          <Picture src={mapsShot} alt="21cutz в Google Maps" formats={['avif', 'webp']} widths={[200, 400]} sizes="200px" loading="lazy" class="phone-img" />
        </div>
      </div>

      <div class="row indent-1">
        <div class="row-text">
          <h3>Доверяват ви се</h3>
          <p>Истински снимки, отзиви и сайт, който изглежда като вашия бизнес.</p>
          <div class="chips">
            <Chip icon={logoWordpress} label="WordPress" />
            <Chip icon={logoShopify} label="Shopify" bg="#FFFFFF" />
          </div>
        </div>
        <div class="phone-frame">
          <Picture src={reviewsShot} alt="Отзиви на 21cutz.com" formats={['avif', 'webp']} widths={[200, 400]} sizes="200px" loading="lazy" class="phone-img" />
        </div>
      </div>

      <div class="row indent-2">
        <div class="row-text">
          <h3>Свързват се с вас</h3>
          <p>Обаждане, съобщение, записан час или поръчка онлайн.</p>
          <div class="chips">
            <Chip icon={logoViber} label="Viber" />
          </div>
        </div>
        <div class="phone-frame">
          <Picture src={bookingShot} alt="Записване на час в book.21cutz.com" formats={['avif', 'webp']} widths={[200, 400]} sizes="200px" loading="lazy" class="phone-img" />
        </div>
      </div>

      <div class="row indent-3">
        <div class="row-text">
          <h3>Измерваме</h3>
          <p>Броим обажданията, записаните часове и поръчките. Виждаме откъде идват.</p>
          <div class="chips">
            <Chip icon={logoGa4} label="Google Analytics" />
            <Chip icon={logoGtm} label="Google Tag Manager" />
          </div>
        </div>
        <div class="chart-box">
          <Image src={chart} alt="" widths={[560, 1120]} sizes="(max-width: 760px) 100vw, 40vw" loading="lazy" class="chart-img" />
        </div>
      </div>

      <div class="row indent-4 last-row">
        <div class="row-text">
          <h3>Подобряваме</h3>
          <p>Местим парите към това, което носи клиенти.</p>
          <div class="chips">
            <Chip icon={logoGoogleAds} label="Google Ads" />
            <div class="meta-chip">
              <Image src={logoMeta} alt="Meta" width={200} height={40} loading="lazy" class="meta-logo" />
            </div>
          </div>
        </div>
      </div>
      <p class="circle-restart">После кръгът започва отначало.</p>
    </div>
  </section>

  <section class="not-needed">
    <div class="not-needed-inner">
      <h2>Казваме ви и какво не ви трябва.</h2>
      <div class="not-needed-text">
        <p>Ако ви стига подреден профил в Google, няма да ви продаваме сайт и реклами.</p>
        <a href="/uslugi/#ne">Кога ще ви кажем да не харчите</a>
      </div>
    </div>
  </section>

  <section class="tools">
    <h2>С тези инструменти работим всеки ден.</h2>
    <div class="tools-grid">
      {
        tools.map((t) => (
          <div class="tool">
            <Image src={t.icon} alt="" width={72} height={72} loading="lazy" class="tool-icon" />
            <span>{t.label}</span>
          </div>
        ))
      }
      <div class="tool">
        <Image src={logoMeta} alt="Meta" width={280} height={56} loading="lazy" class="tool-meta" />
      </div>
      <div class="tool">
        <Image src={logoInstagram} alt="" width={72} height={72} loading="lazy" class="tool-icon" />
        <span>Instagram</span>
      </div>
      <div class="tool">
        <Image src={logoShopify} alt="" width={72} height={72} loading="lazy" class="tool-icon" />
        <span>Shopify</span>
      </div>
    </div>
  </section>

  <section class="selected">
    <div class="selected-head">
      <h2>Избрани проекти.</h2>
      <div class="selected-sub">
        <p>Няколко случая, които показват как работим.</p>
        <a href="/proekti/">Вижте всички</a>
      </div>
    </div>
    <div class="selected-grid">
      {cards.map((c) => <ProjectCard {...c} aspect="4 / 3" />)}
    </div>
  </section>

  <section class="person">
    <div class="person-inner">
      <h2>Зад Riddle стои човек.</h2>
      <p>Казвам се Тихомир. Говорите директно с мен.</p>
      <div class="person-links">
        <a href="tel:+359897853219" class="person-phone">0897 853 219</a>
        <a href="viber://chat?number=%2B359897853219">Viber</a>
        <a href="/za-nas/">Повече за мен</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .meta-chip {
    display: flex;
    align-items: center;
    background: #ffffff;
    padding: 10px 14px;
    border-radius: 4px;
  }
  .meta-chip :global(.meta-logo) {
    height: 20px;
    width: auto;
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }
  .hero-left {
    flex: 1 1 560px;
    padding: clamp(48px, 7vw, 120px) clamp(20px, 5vw, 72px) clamp(40px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(68px, 10.5vw, 176px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 7.5ch;
  }
  .hero-sub {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 520px;
  }
  .hero-sub > p {
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.45;
    margin: 0;
    text-wrap: pretty;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .cta {
    background: var(--accent);
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
    padding: 20px 28px;
    border-radius: 4px;
    text-decoration: none;
  }
  .cta:hover {
    color: var(--text);
  }
  .hero-phone {
    font-size: 18px;
    font-weight: 500;
  }
  .hero-right {
    flex: 1 1 400px;
    background: var(--dark);
    color: var(--bg);
    min-height: 560px;
    padding: clamp(40px, 5vw, 80px) clamp(24px, 4vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(6px, 1vw, 14px);
  }
  .steps-label {
    margin: 0 0 clamp(20px, 2.5vw, 36px);
    font-size: 17px;
    color: var(--muted-on-dark);
  }
  .step {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 5vw, 84px);
    line-height: 0.95;
  }
  .step.indent-1 {
    margin-left: clamp(0px, 2vw, 32px);
  }
  .step.indent-2 {
    margin-left: clamp(0px, 4vw, 64px);
  }
  .step.accent {
    color: var(--accent);
  }
  .clients-strip {
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
  }
  .clients-strip > p {
    flex: 0 1 220px;
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
  }
  .client-logos {
    flex: 1 1 560px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .client-tile {
    background: #ffffff;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
  }
  .client-tile.dark-tile {
    background: #0a0a0a;
  }
  .client-tile.ladybird-tile {
    padding: 8px;
  }
  .client-tile :global(.client-img) {
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .client-tile :global(.client-img.cutz) {
    max-height: 76px;
  }
  .client-tile :global(.client-img.scaffrent) {
    max-height: 84px;
  }
  .client-tile :global(.client-img.hairsupply) {
    max-height: 70px;
  }
  .client-tile :global(.client-img.ladybird) {
    height: 100%;
    max-height: 88px;
  }
  .circle {
    background: var(--dark);
    color: var(--bg);
  }
  .circle-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 160px) clamp(20px, 5vw, 72px);
  }
  .circle-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  .circle-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(60px, 9vw, 150px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 8ch;
  }
  .circle-head p {
    margin: 0;
    max-width: 30ch;
    font-size: 20px;
    line-height: 1.45;
    color: var(--muted-on-dark);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 56px;
    padding: 40px 0;
    border-top: 1px solid rgba(243, 240, 233, 0.22);
  }
  .row.indent-1 {
    margin-left: clamp(0px, 4vw, 64px);
  }
  .row.indent-2 {
    margin-left: clamp(0px, 8vw, 128px);
  }
  .row.indent-3 {
    margin-left: clamp(0px, 12vw, 192px);
  }
  .row.indent-4 {
    margin-left: clamp(0px, 16vw, 256px);
  }
  .row.last-row {
    border-bottom: 1px solid rgba(243, 240, 233, 0.22);
  }
  .row-text {
    flex: 1 1 360px;
  }
  .row-text h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 6.5vw, 104px);
    line-height: 0.9;
    margin: 0;
  }
  .row-text p {
    font-size: 19px;
    line-height: 1.45;
    margin: 16px 0 22px;
    color: var(--muted-on-dark);
    max-width: 34ch;
  }
  .phone-frame {
    flex: 0 0 200px;
    aspect-ratio: 9 / 19;
    border: 1px solid rgba(243, 240, 233, 0.35);
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .phone-frame :global(.phone-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .chart-box {
    flex: 1 1 420px;
    max-width: 600px;
    background: #ffffff;
    padding: 16px;
    border-radius: 4px;
  }
  .chart-box :global(.chart-img) {
    width: 100%;
    height: auto;
  }
  .circle-restart {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 3.4vw, 52px);
    line-height: 1;
    margin: 40px 0 0;
  }
  .not-needed {
    background: var(--bg-alt);
  }
  .not-needed-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(80px, 10vw, 160px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
    align-items: flex-end;
  }
  .not-needed h2 {
    flex: 1 1 620px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .not-needed-text {
    flex: 0 1 380px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .not-needed-text p {
    margin: 0;
    font-size: 22px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .not-needed-text a {
    font-size: 18px;
    font-weight: 600;
  }
  .tools {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(72px, 8vw, 128px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
  }
  .tools h2 {
    flex: 0 1 380px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 0.95;
    margin: 0;
  }
  .tools-grid {
    flex: 1 1 620px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    column-gap: 32px;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.16);
  }
  .tool span {
    font-size: 19px;
    font-weight: 600;
  }
  .tool :global(.tool-icon) {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }
  .tool :global(.tool-meta) {
    height: 28px;
    width: auto;
  }
  .selected {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(40px, 4vw, 64px) clamp(20px, 5vw, 72px) clamp(96px, 10vw, 160px);
  }
  .selected-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    align-items: flex-end;
    justify-content: space-between;
    margin: 0 0 clamp(40px, 5vw, 64px);
  }
  .selected-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 7vw, 112px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .selected-sub {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 34ch;
  }
  .selected-sub p {
    margin: 0;
    font-size: 19px;
    line-height: 1.45;
  }
  .selected-sub a {
    font-size: 18px;
    font-weight: 600;
  }
  .selected-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 56px clamp(20px, 3vw, 40px);
  }
  .person {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-top: 1px solid rgba(26, 26, 23, 0.14);
  }
  .person-inner {
    flex: 1 1 440px;
    padding: clamp(48px, 7vw, 112px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }
  .person h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 7.5vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 8ch;
  }
  .person-inner > p {
    margin: 0;
    font-size: 22px;
    line-height: 1.45;
    max-width: 30ch;
  }
  .person-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
  }
  .person-phone {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4vw, 56px);
    line-height: 1;
    text-decoration: none;
  }
  .person-links a:not(.person-phone) {
    font-size: 18px;
  }
</style>
