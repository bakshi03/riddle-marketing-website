    margin: clamp(32px, 4vw, 48px) 0 0;
    padding-top: clamp(28px, 3vw, 44px);
    border-top: 1px solid rgba(243, 240, 233, 0.22);
    font-size: clamp(19px, 1.7vw, 23px);
    line-height: 1.5;
    max-width: 52ch;
  }
  .case-images {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 120px) clamp(20px, 5vw, 72px) 0;
  }
  .images-row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 3vw, 48px);
    justify-content: center;
  }
  .images-row figure {
    margin: 0;
    flex: 0 1 320px;
  }
  .shot-frame {
    background: #ffffff;
    border: 1px solid rgba(26, 26, 23, 0.14);
    padding: 10px;
    aspect-ratio: 3 / 5;
  }
  .shot-frame :global(picture) {
    display: block;
    height: 100%;
  }
  .shot-frame :global(.shot-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .images-row figcaption {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.4;
  }
  .case-quote {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 128px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px clamp(40px, 5vw, 88px);
  }
  .quote-photo {
    flex: 0 1 380px;
    min-width: 260px;
  }
  .quote-photo :global(.quote-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  blockquote {
    flex: 1 1 440px;
    margin: 0;
    max-width: 920px;
  }
  .quote-text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1.02;
  }
  blockquote footer {
    margin-top: 20px;
    font-size: 18px;
  }
  .case-live {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 72px) clamp(96px, 10vw, 160px);
  }
  .case-live p {
    margin: 0 0 8px;
    font-size: 18px;
  }
  .case-live a {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 4vw, 64px);
    line-height: 1;
    color: var(--text);
  }
  .hero-text :global(.client-logo) {
    width: auto;
    max-width: 200px;
    max-height: 64px;
    object-fit: contain;
    margin-bottom: 24px;
  }
  .hero-stats {
    margin-top: clamp(28px, 3vw, 44px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 0 clamp(24px, 3vw, 40px);
    max-width: 560px;
  }
  .hero-stat {
    padding: 14px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.16);
  }
  .hero-stat-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 2.8vw, 44px);
    line-height: 1;
  }
  .hero-stat-label {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.35;
    color: rgba(26, 26, 23, 0.7);
  }
  .chart {
    padding: clamp(28px, 3vw, 44px) 0 0;
    border-top: 1px solid rgba(243, 240, 233, 0.22);
  }
  .chart .group-head {
    margin-bottom: clamp(28px, 3.5vw, 48px);
  }
  .chart-plot,
  .chart-axis {
    display: flex;
    gap: clamp(6px, 1.4vw, 20px);
  }
  .chart-plot {
    align-items: flex-end;
    height: clamp(200px, 26vw, 320px);
    padding-top: 34px;
    box-sizing: content-box;
    border-bottom: 1px solid rgba(243, 240, 233, 0.35);
  }
  .chart-col {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }
  .chart-col.marked,
  .chart-month.marked {
    border-left: 2px dashed var(--accent);
  }
  .chart-value {
    margin: 0 0 8px;
    font-size: clamp(11px, 1.3vw, 16px);
    font-weight: 600;
    color: var(--muted-on-dark);
    white-space: nowrap;
  }
