---
import { Picture, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Placeholder from '../../components/Placeholder.astro';

// Unpublished cases are built only in development, so the layout can be
// reviewed with visible empty slots. In production they do not exist as pages.
export async function getStaticPaths() {
  const entries = await getCollection('cases', (e) => (import.meta.env.PROD ? e.data.published : true));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/img/*.{jpg,jpeg,png,svg,webp}',
  { eager: true }
);
const img = (name?: string) =>
  name ? Object.entries(allImages).find(([p]) => p.endsWith(`/${name}`))?.[1]?.default : undefined;

const heroImg = img(d.hero?.src);
const quoteImg = img(d.quote?.photo) ?? img(d.quoteImage?.src);
const quoteImgAlt = d.quote?.photo ? d.quote.author : (d.quoteImage?.alt ?? d.client);
const gallery = d.images
  .map((im) => ({ ...im, meta: img(im.src) }))
  .filter((im): im is typeof im & { meta: ImageMetadata } => Boolean(im.meta));

const groupDefs = d.resultGroups ?? [
  { id: 'site', title: 'От сайта', source: 'Източник: Google Analytics 4' },
  { id: 'ads', title: 'От рекламите в Google', source: 'Източник: Google Ads' },
];
const groups = groupDefs
  .map((g) => ({ ...g, results: d.results.filter((r) => r.group === g.id) }))
  .filter((g) => g.results.length > 0);

const logoImg = img(d.logo);
const dashImg = img(d.dashboard?.image);

// Bulgarian number formatting for the chart: space as thousands separator.
const fmt = (n: number) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const chartMax = d.chart ? Math.max(...d.chart.points.map((p) => p.value)) : 0;

const siteUrlText = d.siteUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');

const title = `${d.title ?? `${d.client}: ${d.category}`} | Riddle Marketing`;
const description = [d.intro, d.highlight ? `${d.highlight.value} ${d.highlight.label}.` : '']
  .filter(Boolean)
  .join(' ');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Начало', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Проекти', item: new URL('/proekti/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.client, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Base
  title={title}
  description={description || `${d.client}. ${d.category}. Какво направихме и какво донесе.`}
  ogImage={heroImg?.src}
>
  <Header current="projects" />

  {
    !d.published && (
      <div class="draft-band">
        ЧЕРНОВА. Тази страница се вижда само в режим на разработка и не се публикува.
      </div>
    )
  }

  <section class="case-hero">
    <div class="hero-text">
      <nav class="breadcrumb" aria-label="Навигация по страницата">
        <a href="/">Начало</a>
        <span aria-hidden="true">›</span>
        <a href="/proekti/">Проекти</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{d.client}</span>
      </nav>
      {logoImg && <Image src={logoImg} alt={d.client} width={240} loading="eager" class="client-logo" />}
      <h1>{d.title ? d.title : <Placeholder note="заглавие на казуса" />}</h1>
      <p class="intro">{d.intro ? d.intro : <Placeholder note="кратко представяне на бизнеса" />}</p>
      {
        d.heroStats.length > 0 && (
          <div class="hero-stats">
            {d.heroStats.map((s) => (
              <div class="hero-stat">
                <p class="hero-stat-value">{s.value}</p>
                <p class="hero-stat-label">{s.label}</p>
              </div>
            ))}
          </div>
        )
      }
      <p class="facts">
        {d.category}
        {d.location && <span class="fact-sep" aria-hidden="true">·</span>}
        {d.location}
        {d.period && <span class="fact-sep" aria-hidden="true">·</span>}
        {d.period}
      </p>
    </div>
    <div class="hero-photo">
      {
        heroImg ? (
          <Picture
            src={heroImg}
            alt={d.hero?.alt ?? d.client}
            formats={['avif', 'webp']}
            widths={[480, 760, 1100]}
            sizes="(max-width: 759px) 100vw, 44vw"
            loading="eager"
            class="hero-img"
          />
        ) : (
          <div class="photo-empty">
            <Placeholder note="голяма снимка на клиента" />
          </div>
        )
      }
    </div>
  </section>

  <section class="case-before">
    <div class="before-inner">
      <h2>Преди</h2>
      <p>{d.before ? d.before : <Placeholder note="как стояха нещата, преди да започнем" />}</p>
    </div>
  </section>

  <section class="case-did">
    <h2>Какво направихме</h2>
    <div class="did-list">
      {
        d.services.length > 0 ? (
          d.services.map((s) => {
            const logo = img(s.logo);
            return (
              <div class="did-item">
                {logo && <Image src={logo} alt="" width={72} height={72} loading="lazy" class="did-icon" />}
                <span>{s.name}</span>
              </div>
            );
          })
        ) : (
          <p>
            <Placeholder note="списък с услугите по проекта" />
          </p>
        )
      }
    </div>
  </section>

  <section class="case-results">
    <div class="case-results-inner">
      <h2>Резултатът</h2>
      {
        groups.length > 0 ? (
          groups.map((g) => (
            <div class="result-group">
              <div class="group-head">
                <h3>{g.title}</h3>
                <p class="group-source">{g.source}</p>
              </div>
              <div class="results-grid">
                {g.results.map((r) => (
                  <div class="result">
                    <p class="result-value">{r.value}</p>
                    <p class="result-label">{r.label}</p>
                  </div>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p class="result-label">
            <Placeholder note="числа от GA4 и Google Ads, в две групи" />
          </p>
        )
      }
      {
        d.chart && (
          <div class="chart">
            <div class="group-head">
              <h3>{d.chart.title}</h3>
              {d.chart.source && <p class="group-source">{d.chart.source}</p>}
            </div>
            <div aria-hidden="true">
              <div class="chart-plot">
                {d.chart.points.map((p, i) => (
                  <div class={`chart-col${i === d.chart!.markIndex ? ' marked' : ''}`}>
                    <p class="chart-value">{fmt(p.value)}</p>
                    <div
                      class={`chart-bar${i >= d.chart!.markIndex ? ' after' : ''}`}
                      style={`height: ${Math.round((p.value / chartMax) * 100)}%`}
                    />
                  </div>
                ))}
              </div>
              <div class="chart-axis">
                {d.chart.points.map((p, i) => (
                  <p class={`chart-month${i === d.chart!.markIndex ? ' marked' : ''}`}>
                    {p.label}
                    {p.note && <small>{p.note}</small>}
                    {i === d.chart!.markIndex && <small class="chart-mark">{d.chart!.markLabel}</small>}
                  </p>
                ))}
              </div>
            </div>
            <table class="visually-hidden">
              <caption>{d.chart.title}</caption>
              <thead>
                <tr>
                  <th scope="col">Месец</th>
                  <th scope="col">Продажби в евро</th>
                </tr>
              </thead>
              <tbody>
                {d.chart.points.map((p, i) => (
                  <tr>
                    <th scope="row">
                      {p.label}
                      {p.note ? ` (${p.note})` : ''}
                      {i === d.chart!.markIndex ? ` (${d.chart!.markLabel})` : ''}
                    </th>
                    <td>{fmt(p.value)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      {d.resultsNote && <p class="results-note">{d.resultsNote}</p>}
    </div>
  </section>

  {
    d.dashboard && (
      <section class="case-dash">
        <div class="dash-head">
          <h2>{d.dashboard.title}</h2>
          <p>{d.dashboard.caption}</p>
        </div>
        <figure class="dash-frame">
          {
            dashImg ? (
              <Picture
                src={dashImg}
                alt={d.dashboard.imageAlt ?? d.dashboard.title}
                formats={['avif', 'webp']}
                widths={[760, 1200, 1800]}
                sizes="(max-width: 1440px) 95vw, 1296px"
                loading="lazy"
                class="dash-img"
              />
            ) : (
              <div class="dash-empty">
                <Placeholder note="скрийншот от таблото в Looker Studio" />
              </div>
            )
          }
        </figure>
      </section>
    )
  }

  {
    gallery.length > 0 && (
      <section class="case-images">
        <div class="images-row">
          {gallery.map((im) => (
            <figure>
              <div class="shot-frame">
                <Picture
                  src={im.meta}
                  alt={im.alt}
                  formats={['avif', 'webp']}
                  widths={[320, 640]}
                  sizes="(max-width: 759px) 90vw, 320px"
                  loading="lazy"
                  class="shot-img"
                />
              </div>
              {im.caption && <figcaption>{im.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    d.quote && (
      <section class="case-quote">
        {quoteImg && (
          <div class="quote-photo">
            <Picture
              src={quoteImg}
              alt={quoteImgAlt}
              formats={['avif', 'webp']}
              widths={[420, 840]}
              sizes="(max-width: 759px) 100vw, 380px"
              loading="lazy"
              class="quote-img"
            />
          </div>
        )}
        <blockquote>
          <p class="quote-text">{d.quote.text}</p>
          <footer>
            {d.quote.author}, {d.quote.role}
          </footer>
        </blockquote>
      </section>
    )
  }

  {
    d.siteUrl && (
      <section class="case-live">
        <p>Вижте резултата на живо:</p>
        <a href={d.siteUrl} rel="noopener">{siteUrlText}</a>
      </section>
    )
  }

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <script>
    // Big result numbers count up from 0 when they scroll into view.
    // Bulgarian formatting: space for thousands, comma for decimals.
    const els = document.querySelectorAll<HTMLElement>('.result-value');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window && els.length > 0) {
      const format = (n: number, decimals: number) => {
        const [int, dec] = n.toFixed(decimals).split('.');
        const grouped = int.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
        return dec ? `${grouped},${dec}` : grouped;
      };
      const animate = (el: HTMLElement) => {
        const text = el.textContent ?? '';
        const match = text.match(/\d(?:[\d\s]*\d)?(?:,\d+)?/);
        if (!match || match.index === undefined) return;
        const raw = match[0];
        const target = parseFloat(raw.replace(/\s/g, '').replace(',', '.'));
        if (!isFinite(target)) return;
        const decimals = (raw.split(',')[1] ?? '').length;
        const prefix = text.slice(0, match.index);
        const suffix = text.slice(match.index + raw.length);
        const duration = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = prefix + format(target * eased, decimals) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (!en.isIntersecting) continue;
            io.unobserve(en.target);
            animate(en.target as HTMLElement);
          }
        },
        { threshold: 0.5 }
      );
      els.forEach((el) => io.observe(el));
    }
  </script>
</Base>

<style>
  .draft-band {
    background: var(--accent);
    padding: 12px clamp(20px, 5vw, 72px);
    font-weight: 700;
    font-size: 16px;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 15px;
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .breadcrumb a {
    color: var(--text);
  }
  .breadcrumb span[aria-current] {
    font-weight: 600;
  }
  .case-hero {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(40px, 5vw, 80px) clamp(20px, 5vw, 72px) clamp(48px, 6vw, 96px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px clamp(40px, 5vw, 88px);
    align-items: center;
  }
  .hero-text {
    flex: 1 1 480px;
    min-width: 0;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 6.5vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 14ch;
  }
  .intro {
    margin: 28px 0 0;
    font-size: clamp(19px, 1.7vw, 23px);
    line-height: 1.5;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .facts {
    margin: 24px 0 0;
    font-size: 16px;
    color: rgba(26, 26, 23, 0.7);
  }
  .fact-sep {
    margin: 0 8px;
  }
  .hero-photo {
    flex: 1 1 380px;
    max-width: 560px;
  }
  .hero-photo :global(.hero-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .photo-empty {
    aspect-ratio: 4 / 5;
    background: var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 0.95;
    margin: 0;
  }
  .case-before {
    background: var(--bg-alt);
  }
  .before-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 24px 72px;
  }
  .case-before h2 {
    flex: 0 1 340px;
  }
  .case-before p {
    flex: 1 1 480px;
    margin: 0;
    font-size: clamp(19px, 1.7vw, 23px);
    line-height: 1.5;
    max-width: 52ch;
  }
  .case-did {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 104px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px 72px;
  }
  .case-did h2 {
    flex: 0 1 340px;
  }
  .did-list {
    flex: 1 1 480px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    column-gap: 32px;
    align-content: start;
  }
  .did-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.16);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }
  .did-item :global(.did-icon) {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    object-fit: contain;
  }
  .case-results {
    background: var(--dark);
    color: var(--bg);
  }
  .case-results-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 128px) clamp(20px, 5vw, 72px);
  }
