---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  label?: string;
  alt?: string;
  bg?: string;
  small?: boolean;
}

const { icon, label, alt = '', bg = '#F3F0E9', small = false } = Astro.props;
const size = small ? 20 : 26;
---

<div class:list={['chip', { small }]} style={`background:${bg}`}>
  <Image src={icon} alt={alt} width={size * 2} height={size * 2} style={`width:${size}px;height:${size}px;object-fit:contain`} loading="lazy" />
  {label && <span>{label}</span>}
</div>

<style>
  .chip {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    padding: 7px 12px 7px 8px;
    border-radius: 4px;
  }
  .chip span {
    font-weight: 600;
    font-size: 15px;
  }
  .chip.small {
    gap: 6px;
    padding: 5px 10px 5px 6px;
  }
  .chip.small span {
    font-size: 14px;
  }
</style>
