---
// Shared structure of the five service pages: headline and opening line,
// CTA and phone, one real client example, "Какво получавате", "Как протича",
// "Кога не ви трябва", FAQ. The final CTA comes from the Footer band.
// The example image is passed through the default slot (art direction stays
// in each page); the optional "extra" slot renders after "Кога не ви трябва".
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Faq from './Faq.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  title: string;
  description: string;
  headline: string;
  opening: string;
  exampleClient: string;
  exampleResult?: string;
  whatYouGet: string[];
  steps: string[];
  whenNot?: { situation: string; verdict: string };
  measureLine?: string;
  faq: { q: string; a?: string }[];
}

const {
  title,
  description,
  headline,
  opening,
  exampleClient,
  exampleResult,
  whatYouGet,
  steps,
  whenNot,
  measureLine,
  faq,
} = Astro.props;

const calUrl = 'https://cal.com/tihomir-paunov-9sigpg/безплатен-30-минутен-разговор';
---

<Base title={title} description={description}>
  <Header current="services" />

  <section class="sv-hero">
    <h1>{headline}</h1>
    <div class="sv-hero-sub">
      <p>{opening}</p>
      <div class="sv-cta">
        <a href={calUrl} class="cta">Запазете 30-минутен разговор</a>
        <a href="tel:+359897853219" class="sv-phone">или се обадете: 0897 853 219</a>
      </div>
    </div>
  </section>

  <section class="sv-example">
    <div class="sv-example-inner">
      <figure class="sv-example-media">
        <slot />
      </figure>
      <div class="sv-example-text">
        <p class="sv-example-label">Истински пример</p>
        <p class="sv-example-client">{exampleClient}</p>
        <p class="sv-example-result">
          {exampleResult ? exampleResult : <Placeholder note="резултат с число и за какъв период" />}
        </p>
      </div>
    </div>
  </section>

  <section class="sv-get">
    <h2>Какво получавате</h2>
    <div class="sv-get-list">
      {whatYouGet.map((item) => <p>{item}</p>)}
    </div>
  </section>

  {
    measureLine && (
      <section class="sv-measure">
        <p>{measureLine}</p>
      </section>
    )
  }

  <section class="sv-how">
    <div class="sv-how-inner">
      <h2>Как протича</h2>
      <div class="sv-steps">
        {
          steps.map((step, i) => (
            <div class:list={['sv-step', `indent-${i}`]}>
              <p class="sv-step-text">{step}</p>
              <p class="sv-step-timing">
                <Placeholder note="срок" />
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sv-not">
    <div class="sv-not-inner">
      <h2>Кога не ви трябва</h2>
      {
        whenNot ? (
          <div class="sv-not-case">
            <p class="situation">{whenNot.situation}</p>
            <p class="verdict">{whenNot.verdict}</p>
          </div>
        ) : (
          <div class="sv-not-case">
            <p class="situation">
              <Placeholder note="кога не ви трябва тази услуга, с кратка присъда" />
            </p>
          </div>
        )
      }
    </div>
  </section>

  <slot name="extra" />

  <Faq items={faq} />

  <Footer />
</Base>

<style>
  .sv-hero {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 128px) clamp(20px, 5vw, 72px) clamp(48px, 6vw, 96px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
    align-items: flex-end;
  }
  h1 {
    flex: 1 1 620px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(60px, 9vw, 148px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 10ch;
  }
  .sv-hero-sub {
    flex: 0 1 420px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .sv-hero-sub > p {
    margin: 0;
    font-size: 21px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .sv-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .cta {
    background: var(--accent);
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
    padding: 20px 28px;
    border-radius: 4px;
    text-decoration: none;
  }
  .cta:hover {
    color: var(--text);
  }
  .sv-phone {
    font-size: 18px;
    font-weight: 500;
  }
  .sv-example {
    background: var(--bg-alt);
  }
  .sv-example-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 112px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .sv-example-media {
    flex: 1 1 480px;
    max-width: 680px;
    margin: 0;
  }
  .sv-example-text {
    flex: 1 1 340px;
  }
  .sv-example-label {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
  }
  .sv-example-client {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 4.5vw, 68px);
    line-height: 0.92;
  }
  .sv-example-result {
    margin: 0;
    font-size: 19px;
    line-height: 1.45;
    max-width: 36ch;
  }
  .sv-get {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 128px) clamp(20px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
  }
  .sv-get h2,
  .sv-not h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 5vw, 76px);
    line-height: 0.92;
    margin: 0;
  }
  .sv-get h2 {
    flex: 0 1 380px;
  }
  .sv-get-list {
    flex: 1 1 560px;
  }
  .sv-get-list p {
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.16);
    font-size: clamp(19px, 1.7vw, 23px);
    line-height: 1.4;
  }
  .sv-measure {
    border-top: 1px solid rgba(26, 26, 23, 0.14);
  }
  .sv-measure p {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) clamp(20px, 5vw, 72px);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 4.5vw, 72px);
    line-height: 0.95;
  }
  .sv-how {
    background: var(--dark);
    color: var(--bg);
  }
  .sv-how-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(72px, 9vw, 144px) clamp(20px, 5vw, 72px);
  }
  .sv-how h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 6vw, 96px);
    line-height: 0.9;
    margin: 0 0 clamp(40px, 5vw, 72px);
  }
  .sv-steps {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 56px);
  }
  .sv-step.indent-1 {
    margin-left: clamp(0px, 8vw, 128px);
  }
  .sv-step.indent-2 {
    margin-left: clamp(0px, 16vw, 256px);
  }
  @media (max-width: 599.98px) {
    .sv-step.indent-1 { margin-left: 12px; }
    .sv-step.indent-2 { margin-left: 24px; }
  }
  .sv-step-text {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 3.4vw, 52px);
    line-height: 0.95;
    max-width: 24ch;
  }
  .sv-step-timing {
    margin: 0;
    font-size: 16px;
    color: var(--muted-on-dark);
  }
  .sv-not {
    background: var(--bg-alt);
  }
  .sv-not-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 128px) clamp(20px, 5vw, 72px);
  }
  .sv-not h2 {
    margin: 0 0 clamp(32px, 4vw, 56px);
  }
  .sv-not-case {
    max-width: 760px;
  }
  .situation {
    margin: 0 0 12px;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.4;
  }
  .verdict {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 7vw, 112px);
    line-height: 0.9;
  }
</style>
