---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// TODO: add src/assets/dashboard-bg.jpg (a presentable dashboard shot).
// The old live-dashboard.png screenshot is retired; the figure below stays
// hidden until the new file exists.
const dashboard = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/dashboard-bg.jpg', { eager: true })
)[0]?.default;

const contrast = [
  { usual: 'Месечен PDF отчет', ours: 'Табло на живо' },
  { usual: 'Кликове и импресии', ours: 'Обаждания, записани часове и поръчки' },
  { usual: 'Само числата от рекламата', ours: 'Рекламите и сайтът на едно място' },
  { usual: 'Неясно колко е похарчено', ours: 'Разходът и какво е донесъл' },
];
---

<section class="reporting">
  <div class="rep-inner">
    <div class="rep-head">
      <h2>Виждате резултатите по всяко време.</h2>
      <p>
        Имате табло на живо с обажданията, записаните часове, поръчките и похарчените пари.
        Отваряте го от телефона, когато поискате.
      </p>
    </div>
    <div class="rep-grid">
      <div class="rep-col usual">
        <h3>Обикновено получавате</h3>
        {contrast.map((r) => <p>{r.usual}</p>)}
      </div>
      <div class="rep-col ours">
        <h3>При нас получавате</h3>
        {contrast.map((r) => <p>{r.ours}</p>)}
      </div>
    </div>
    {
      dashboard && (
        <figure class="rep-shot">
          <a href={dashboard.src} class="rep-zoom" aria-label="Отворете таблото в пълен размер">
            <Picture
              src={dashboard}
              alt="Табло на живо: разходи, кликове и конверсии от рекламите"
              formats={['avif', 'webp']}
              widths={[760, 1200, 1800]}
              sizes="(max-width: 1440px) 95vw, 1296px"
              loading="lazy"
              class="rep-img"
            />
          </a>
          <figcaption>Табло на живо на клиент. Имената на кампаниите са скрити.</figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .reporting {
    border-top: 1px solid rgba(26, 26, 23, 0.14);
  }
  .rep-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(72px, 9vw, 144px) clamp(20px, 5vw, 72px);
  }
  .rep-head {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 72px;
    align-items: flex-end;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .rep-head h2 {
    flex: 1 1 560px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 7vw, 112px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 11ch;
  }
  .rep-head p {
    flex: 0 1 400px;
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
  }
  .rep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px clamp(24px, 4vw, 56px);
  }
  .rep-col h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1;
    margin: 0 0 8px;
  }
  .rep-col p {
    margin: 0;
    padding: 16px 0;
    border-top: 1px solid rgba(26, 26, 23, 0.16);
    font-size: 19px;
    line-height: 1.4;
  }
  .rep-col.usual p,
  .rep-col.usual h3 {
    color: rgba(26, 26, 23, 0.55);
  }
  .rep-col.ours p {
    font-weight: 600;
    border-top-color: rgba(26, 26, 23, 0.3);
  }
  .rep-col.ours {
    border-left: 4px solid var(--accent);
    padding-left: clamp(16px, 2vw, 28px);
  }
  .rep-shot {
    margin: clamp(40px, 5vw, 64px) 0 0;
    border: 1px solid rgba(26, 26, 23, 0.16);
    border-radius: 4px;
    overflow: hidden;
  }
  .rep-shot :global(.rep-img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .rep-zoom {
    display: block;
    /* Tap opens the image full size; on desktop the pointer hints the same. */
    cursor: zoom-in;
  }
  .rep-shot figcaption {
    padding: 12px 16px;
    font-size: 14px;
    background: #ffffff;
  }
</style>
